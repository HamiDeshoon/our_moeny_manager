# --- Database (PostgreSQL) ---
# Required for multi-device sync and persistent storage.
# Get a free PostgreSQL URL from Neon (https://neon.tech), Supabase, or Render.
# If not set, the app falls back to a local JSON file (single-device only).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Gemini AI API Key ---
# Required for voice parsing, receipt scanning, and AI insights.
# Get one from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# --- Frontend Gemini Key (optional, for static/GitHub Pages builds) ---
# If set at build time, the browser can call Gemini directly when no backend is available.
VITE_GEMINI_API_KEY=""

# --- App URL ---
# The URL where the app is hosted (used for self-referential links).
APP_URL="http://localhost:3000"

# --- Vercel API Token ---
VERCEL_TOKEN=""
